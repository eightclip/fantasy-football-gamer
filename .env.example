# Copy to .env.local (never commit it) or run `npm run setup`, which writes it for you.
# In production these live in your Vercel project's Environment Variables.

# ---- Your league -------------------------------------------------------------
# sleeper or espn
PLATFORM=sleeper
# The number in your league's URL
LEAGUE_ID=
# Sleeper only: your username (not your team name)
SLEEPER_USERNAME=
# ESPN only: teamId from your team page URL
ESPN_TEAM_ID=
# ESPN private leagues only: cookies from a logged-in browser (docs/PLATFORMS.md)
ESPN_S2=
ESPN_SWID=

# ---- How the site talks -------------------------------------------------------
# First name used in alerts and AI answers (optional)
MANAGER_NAME=
# Your time zone (IANA name)
TIMEZONE=America/New_York
# Your deployed URL, e.g. https://my-team.vercel.app (set after the first deploy)
SITE_URL=
SITE_NAME=Fantasy Football Gamer
# When your league's waiver claims finish, in TIMEZONE
WAIVER_DAY=Wednesday
WAIVER_HOUR=3

# ---- Secrets (npm run setup generates these; keep them private) ----------------
# The PIN or passphrase to open the site. 8+ characters.
ACCESS_PIN=
# Random strings, e.g. `openssl rand -base64 32`
GATE_SECRET=
CRON_SECRET=
MCP_SECRET=
# Web push keys: `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Added automatically by `vercel blob create-store ... --access private`
BLOB_READ_WRITE_TOKEN=

# ---- Optional AI wording ------------------------------------------------------------
# Anthropic API key. Without it the summary line uses plain rule-written text.
ANTHROPIC_API_KEY=
ADVICE_MODEL=claude-haiku-4-5
# Set to off to skip the model even when a key is set
ADVICE=
